# إعدادات Firebase (للوحة الإدارة وحفظ الحجوزات)
# 1) انسخ هذا الملف باسم .env.local
# 2) املأ القيم من: Firebase Console ← Project settings ← Your apps ← Web app
# 3) أضف القيم نفسها في Vercel ← Settings ← Environment Variables
# إذا تركتها فارغة يعمل الموقع بدون Firebase (الحجز عبر واتساب فقط).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
